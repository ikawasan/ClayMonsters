#pragma kernel InitializeVoxelData
#pragma kernel GenerateMesh
#pragma kernel ModifyVoxels
#pragma kernel PaintVoxels
#pragma kernel InitializeVoxelColors

#include "MarchingCubesTables.hlsl"

struct Triangle
{
    float3 v1, v2, v3;
    float3 n1, n2, n3;
    float3 c1, c2, c3; // 各頂点の色（ボクセル色から補間）
};

AppendStructuredBuffer<Triangle> _Triangles;
RWStructuredBuffer<float> _Voxels;

// ボクセルごとの色（RGB）_Sizeと同じ解像度
RWStructuredBuffer<float3> _VoxelColors;

int _Size;
float _IsoLevel;
float _Scale;
float3 _Offset; // 中心にずらすためのオフセット値

float3 _HitPosition; // ローカル座標
float _ModRadius;
float _ModStrength;
int _ModBrushShape;
float3 _ModBrushAxisX;
float3 _ModBrushAxisY;
float3 _ModBrushAxisZ;

// 部分更新用 GenerateMeshで処理するチャンクの原点（ボクセル座標）と範囲
int3 _ChunkOrigin;
int3 _ChunkSize;

// ペイント用
float3 _PaintColor;
float _PaintRadius;
float3 _PaintNormal;
float3 _DefaultColor;
int3 _PaintOrigin;
int3 _PaintSize;

// 造形Modify用ブラシAABB
int3 _ModOrigin;
int3 _ModSize;

int GetIndex(int x, int y, int z)
{
    return x * (_Size + 1) * (_Size + 1) + y * (_Size + 1) + z;
}

[numthreads(8, 8, 8)]
void InitializeVoxelData(uint3 id : SV_DispatchThreadID)
{
    if (id.x > (uint) _Size || id.y > (uint) _Size || id.z > (uint) _Size)
    {
        return;
    }

    int idx = GetIndex(id.x, id.y, id.z);
    float3 localPos = (float3) id * _Scale - _Offset;
    
    // 中心に球体を作成
    float dist = length(localPos);
    float initialRadius = (_Size * _Scale) * 0.25;
    float val = initialRadius - dist;
    
    if (id.x == 0 || id.x == (uint) _Size || id.y == 0 || id.y == (uint) _Size || id.z == 0 || id.z == (uint) _Size)
    {
        val = -1.0;
    }

    _Voxels[idx] = val;
}

// ボクセル色を既定色で初期化する
[numthreads(8, 8, 8)]
void InitializeVoxelColors(uint3 id : SV_DispatchThreadID)
{
    if (id.x > (uint) _Size || id.y > (uint) _Size || id.z > (uint) _Size)
    {
        return;
    }

    int idx = GetIndex(id.x, id.y, id.z);
    _VoxelColors[idx] = _DefaultColor;
}

float3 Interpolate(float3 p1, float v1, float3 p2, float v2)
{
    float delta = v2 - v1;
    if (abs(delta) < 1e-5)
    {
        return (p1 + p2) * 0.5;
    }

    float t = saturate((_IsoLevel - v1) / delta);
    return p1 + t * (p2 - p1);
}

float3 SafeNormalize(float3 n)
{
    float lenSq = dot(n, n);
    if (lenSq < 1e-10)
    {
        return float3(0, 1, 0);
    }

    return n * rsqrt(lenSq);
}

float3 GetNormalAt(uint3 p)
{
    float3 n;
    n.x = _Voxels[GetIndex(clamp(p.x + 1, 0, _Size), p.y, p.z)] - _Voxels[GetIndex(clamp(p.x - 1, 0, _Size), p.y, p.z)];
    n.y = _Voxels[GetIndex(p.x, clamp(p.y + 1, 0, _Size), p.z)] - _Voxels[GetIndex(p.x, clamp(p.y - 1, 0, _Size), p.z)];
    n.z = _Voxels[GetIndex(p.x, p.y, clamp(p.z + 1, 0, _Size))] - _Voxels[GetIndex(p.x, p.y, clamp(p.z - 1, 0, _Size))];
    return -SafeNormalize(n);
}

// 既定色かどうかを判定する
bool IsDefaultColor(float3 color)
{
    return distance(color, _DefaultColor) < 0.02;
}

// エッジ上の補間位置に合わせて 2つのコーナーのボクセル色を補間する
float3 InterpolateColor(uint3 cornerA, uint3 cornerB, float valA, float valB)
{
    float t = 0.5;
    float delta = valB - valA;
    if (abs(delta) >= 1e-5)
    {
        t = saturate((_IsoLevel - valA) / delta);
    }

    float3 colorA = _VoxelColors[GetIndex(cornerA.x, cornerA.y, cornerA.z)];
    float3 colorB = _VoxelColors[GetIndex(cornerB.x, cornerB.y, cornerB.z)];

    bool paintedA = !IsDefaultColor(colorA);
    bool paintedB = !IsDefaultColor(colorB);

    // 未塗装の既定色(白っぽいクリーム)を表面に出さない
    if (paintedA && !paintedB)
    {
        return colorA;
    }

    if (!paintedA && paintedB)
    {
        return colorB;
    }

    return lerp(colorA, colorB, t);
}

float EvaluateBrushInfluence(float3 localPos, float3 hitPosition, float radius, int brushShape)
{
    if (radius <= 1e-6)
    {
        return 0.0;
    }

    float3 position = localPos - hitPosition;
    if (brushShape != 0)
    {
        position = float3(
            dot(position, _ModBrushAxisX),
            dot(position, _ModBrushAxisY),
            dot(position, _ModBrushAxisZ));
    }

    if (brushShape == 1)
    {
        float3 absolute = abs(position);
        float maxAxis = max(absolute.x, max(absolute.y, absolute.z));
        if (maxAxis >= radius)
        {
            return 0.0;
        }

        float normalized = maxAxis / radius;
        return 1.0 - normalized * normalized;
    }

    if (brushShape == 2)
    {
        if (position.y < -radius || position.y > radius)
        {
            return 0.0;
        }

        float allowedRadius = saturate((radius - position.y) / (radius * 2.0)) * radius;
        if (allowedRadius <= 1e-6)
        {
            return 0.0;
        }

        float radialDistance = length(position.xz);
        if (radialDistance >= allowedRadius)
        {
            return 0.0;
        }

        float radialNormalized = radialDistance / allowedRadius;
        return 1.0 - radialNormalized * radialNormalized;
    }

    if (brushShape == 3)
    {
        if (position.y < -radius || position.y > radius)
        {
            return 0.0;
        }

        float allowedHalfExtent = saturate((radius - position.y) / (radius * 2.0)) * radius;
        if (allowedHalfExtent <= 1e-6)
        {
            return 0.0;
        }

        float planarDistance = max(abs(position.x), abs(position.z));
        if (planarDistance >= allowedHalfExtent)
        {
            return 0.0;
        }

        float planarNormalized = planarDistance / allowedHalfExtent;
        return 1.0 - planarNormalized * planarNormalized;
    }

    if (brushShape == 4)
    {
        float tubeRadius = radius * 0.35;
        float ringRadius = radius * 0.65;
        float2 ringOffset = float2(length(position.xy) - ringRadius, position.z);
        float distSq = dot(ringOffset, ringOffset);
        float tubeRadiusSq = tubeRadius * tubeRadius;
        if (distSq >= tubeRadiusSq)
        {
            return 0.0;
        }

        return 1.0 - distSq / tubeRadiusSq;
    }

    float radiusSq = radius * radius;
    float sphereDistSq = dot(position, position);
    if (sphereDistSq >= radiusSq)
    {
        return 0.0;
    }

    return 1.0 - sphereDistSq / radiusSq;
}

[numthreads(8, 8, 8)]
void GenerateMesh(uint3 tid : SV_DispatchThreadID)
{
    // ディスパッチされたスレッドIDにチャンク原点を足してボクセル座標を得る
    uint3 id = tid + (uint3) _ChunkOrigin;

    if (tid.x >= (uint) _ChunkSize.x || tid.y >= (uint) _ChunkSize.y || tid.z >= (uint) _ChunkSize.z)
    {
        return;
    }

    if (id.x >= (uint) _Size || id.y >= (uint) _Size || id.z >= (uint) _Size)
    {
        return;
    }

    float vals[8];
    float3 cornerNormals[8];
    int cubeIndex = 0;
    
    for (int i = 0; i < 8; i++)
    {
        uint3 p = id + (uint3) cornerOffsets[i];
        vals[i] = _Voxels[GetIndex(p.x, p.y, p.z)];
        cubeIndex |= (int(vals[i] > _IsoLevel) << i);
        cornerNormals[i] = GetNormalAt(p);
    }
    
    for (int i = 0; triTable[cubeIndex][i] != -1; i += 3)
    {
        Triangle tri;
        
        // 頂点1
        int e1 = triTable[cubeIndex][i];
        int c1_1 = edgeTable[e1][0];
        int c2_1 = edgeTable[e1][1];
        uint3 corner1A = id + (uint3) cornerOffsets[c1_1];
        uint3 corner1B = id + (uint3) cornerOffsets[c2_1];
        float3 p1_1 = (float3) corner1A * _Scale;
        float3 p2_1 = (float3) corner1B * _Scale;
        tri.v1 = Interpolate(p1_1, vals[c1_1], p2_1, vals[c2_1]) - _Offset;
        float t1 = abs(vals[c2_1] - vals[c1_1]) < 1e-5
            ? 0.5
            : saturate((_IsoLevel - vals[c1_1]) / (vals[c2_1] - vals[c1_1]));
        tri.n1 = SafeNormalize(lerp(cornerNormals[c1_1], cornerNormals[c2_1], t1));
        tri.c1 = InterpolateColor(corner1A, corner1B, vals[c1_1], vals[c2_1]);

        // 頂点2
        int e2 = triTable[cubeIndex][i + 1];
        int c1_2 = edgeTable[e2][0];
        int c2_2 = edgeTable[e2][1];
        uint3 corner2A = id + (uint3) cornerOffsets[c1_2];
        uint3 corner2B = id + (uint3) cornerOffsets[c2_2];
        float3 p1_2 = (float3) corner2A * _Scale;
        float3 p2_2 = (float3) corner2B * _Scale;
        tri.v2 = Interpolate(p1_2, vals[c1_2], p2_2, vals[c2_2]) - _Offset;
        float t2 = abs(vals[c2_2] - vals[c1_2]) < 1e-5
            ? 0.5
            : saturate((_IsoLevel - vals[c1_2]) / (vals[c2_2] - vals[c1_2]));
        tri.n2 = SafeNormalize(lerp(cornerNormals[c1_2], cornerNormals[c2_2], t2));
        tri.c2 = InterpolateColor(corner2A, corner2B, vals[c1_2], vals[c2_2]);

        // 頂点3
        int e3 = triTable[cubeIndex][i + 2];
        int c1_3 = edgeTable[e3][0];
        int c2_3 = edgeTable[e3][1];
        uint3 corner3A = id + (uint3) cornerOffsets[c1_3];
        uint3 corner3B = id + (uint3) cornerOffsets[c2_3];
        float3 p1_3 = (float3) corner3A * _Scale;
        float3 p2_3 = (float3) corner3B * _Scale;
        tri.v3 = Interpolate(p1_3, vals[c1_3], p2_3, vals[c2_3]) - _Offset;
        float t3 = abs(vals[c2_3] - vals[c1_3]) < 1e-5
            ? 0.5
            : saturate((_IsoLevel - vals[c1_3]) / (vals[c2_3] - vals[c1_3]));
        tri.n3 = SafeNormalize(lerp(cornerNormals[c1_3], cornerNormals[c2_3], t3));
        tri.c3 = InterpolateColor(corner3A, corner3B, vals[c1_3], vals[c2_3]);

        _Triangles.Append(tri);
    }
}

[numthreads(8, 8, 8)]
void ModifyVoxels(uint3 id : SV_DispatchThreadID)
{
    // idはブラシAABB内の相対座標_ModOriginからのオフセット
    if (id.x >= (uint) _ModSize.x || id.y >= (uint) _ModSize.y || id.z >= (uint) _ModSize.z)
    {
        return;
    }

    uint3 voxelId = (uint3) _ModOrigin + id;
    if (voxelId.x > (uint) _Size || voxelId.y > (uint) _Size || voxelId.z > (uint) _Size)
    {
        return;
    }

    // 境界のボクセルは編集させない
    if (voxelId.x == 0 || voxelId.x == (uint) _Size || voxelId.y == 0 || voxelId.y == (uint) _Size || voxelId.z == 0 || voxelId.z == (uint) _Size)
    {
        return;
    }

    float3 localPos = (float3) voxelId * _Scale - _Offset;
    float influence = EvaluateBrushInfluence(localPos, _HitPosition, _ModRadius, _ModBrushShape);
    if (influence > 0.0)
    {
        influence *= _ModStrength;
        int idx = GetIndex(voxelId.x, voxelId.y, voxelId.z);
        // 極端な密度で等値面補間が壊れるのを防ぐ
        _Voxels[idx] = clamp(_Voxels[idx] + influence, -1.0, 1.0);
    }
}

// ブラシ範囲内のボクセル色を塗る
// idはブラシAABB内の相対座標_PaintOriginからのオフセット
[numthreads(8, 8, 8)]
void PaintVoxels(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) _PaintSize.x || id.y >= (uint) _PaintSize.y || id.z >= (uint) _PaintSize.z)
    {
        return;
    }

    uint3 voxelId = (uint3) _PaintOrigin + id;
    if (voxelId.x > (uint) _Size || voxelId.y > (uint) _Size || voxelId.z > (uint) _Size)
    {
        return;
    }

    float3 localPos = (float3) voxelId * _Scale - _Offset;
    if (distance(localPos, _HitPosition) >= _PaintRadius)
    {
        return;
    }

    // ヒット面の裏側へ塗りが回り込まないよう法線方向の手前側だけに限定する
    // 表面シェルを確実に塗るため内側は数ボクセル分まで許容する
    if (dot(_PaintNormal, _PaintNormal) > 1e-6)
    {
        float3 paintNormal = normalize(_PaintNormal);
        float3 toVoxel = localPos - _HitPosition;
        if (dot(toVoxel, paintNormal) < -_Scale * 2.0)
        {
            return;
        }
    }

    int idx = GetIndex(voxelId.x, voxelId.y, voxelId.z);
    _VoxelColors[idx] = _PaintColor;
}
